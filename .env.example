# =============================================================================
# AI Multi-Agent Orchestrator — Environment Variables Template
# =============================================================================
# This file is safe to commit. It shows what variables are needed.
# Copy this to .env and fill in your real values.

# === LLM Providers ===
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# === Model Selection ===
ROUTER_MODEL=gemini-2.5-flash
AGENT_MODEL=gemini-2.5-flash
FAST_MODEL=gemini-2.5-flash

# === App Config ===
APP_NAME=ai-orchestrator
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# === API Config ===
API_HOST=0.0.0.0
API_PORT=8000

# === Memory Config ===
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=orchestrator_memory

# === Agent Behavior ===
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=30
MAX_CONCURRENT_AGENTS=5
